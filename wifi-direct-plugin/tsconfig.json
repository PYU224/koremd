{
  "compilerOptions": {
    "target": "ES2017",
    "module": "ES2015",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist/esm",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2017", "DOM"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "android"]
}
