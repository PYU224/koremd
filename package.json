{
  "name": "koremd-app",
  "version": "1.1.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "serve": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "ionic:serve": "vite --host=0.0.0.0",
    "ionic:build": "vite build",
    "build:plugin": "cd ../wifi-direct-plugin && npm run build && cd ../koremd-app",
    "build:all": "npm run build:plugin && npm run build",
    "dev:android": "npm run build:all && npx cap sync android && npx cap open android",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.1",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.1",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@ionic/vue": "^8.7.17",
    "@ionic/vue-router": "^8.7.17",
    "@local/wifi-direct": "file:wifi-direct-plugin",
    "highlight.js": "^11.11.1",
    "ionicons": "^8.0.13",
    "marked": "^17.0.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.27",
    "vue-i18n": "^11.2.8",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.1",
    "@rushstack/eslint-patch": "^1.15.0",
    "@types/node": "^25.0.9",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/cli-service": "5.0.9",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "^10.7.0",
    "npm-run-all2": "^8.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.0.4",
    "vue-tsc": "^3.2.2"
  }
}